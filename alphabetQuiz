<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Spanish Alphabet Quiz - Scrambled Sounds</title>
<style>
  body {
    font-family: Arial, sans-serif;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    margin: 0;
    background: #f0f0f0;
  }
  button {
    width: 60px;
    height: 60px;
    margin: 10px;
    font-size: 24px;
    font-weight: bold;
    border-radius: 8px;
    border: 2px solid #007BFF;
    background-color: white;
    cursor: pointer;
    transition: background-color 0.3s;
  }
  button:hover {
    background-color: #cce5ff;
  }
</style>
</head>
<body>

<script>
  // Spanish alphabet letters
  const letters = ['a','b','c','d','e','f','g','h','i','j','k','l','m','n','ñ','o','p','q','r','s','t','u','v','w','x','y','z'];

  // Scramble the letters array (Fisher-Yates shuffle)
  function shuffle(array) {
    const arr = array.slice();
    for (let i = arr.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
  }

  const scrambledLetters = shuffle(letters);

  let currentAudio = null;

  // Create buttons numbered 1 to 27 in order
  for (let i = 1; i <= letters.length; i++) {
    const btn = document.createElement('button');
    btn.textContent = i;
    btn.title = `Play sound for letter "${scrambledLetters[i - 1].toUpperCase()}"`;

    btn.addEventListener('click', () => {
      // Stop currently playing audio if any
      if (currentAudio) {
        currentAudio.pause();
        currentAudio.currentTime = 0;
      }
      // Play the scrambled letter's audio
      currentAudio = new Audio(scrambledLetters[i - 1] + '.mp3');
      currentAudio.play();
    });

    document.body.appendChild(btn);
  }
</script>

</body>
</html>

